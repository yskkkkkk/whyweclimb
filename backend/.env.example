# Database
DB_URL=jdbc:mysql://localhost:3306/whyweclimb?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (Base64-encoded secret, minimum 32 bytes before encoding)
JWT_SECRET=your_base64_encoded_jwt_secret

# Jasypt encryption password
JASYPT_ENCRYPTOR_PASSWORD=your_jasypt_password

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000
